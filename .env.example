# =============================================================================
# House Price MLOps - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ----- Kaggle -----
# Get your token at https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ----- MLflow -----
MLFLOW_TRACKING_URI=http://89.58.44.97:5000
MLFLOW_EXPERIMENT_NAME=house-price-prediction

# ----- PostgreSQL -----
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_password
POSTGRES_DB=mlops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----- Gmail SMTP (for alerting) -----
# Use an App Password: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENTS=team_member1@email.com,team_member2@email.com

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Webapp -----
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=7860

# ----- MinIO S3 -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_DATA=mlops-data
