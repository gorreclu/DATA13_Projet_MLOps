# =============================================================================
# Kubernetes Secrets - Template
# =============================================================================
# Usage:
#   1. Copy this file:  cp k8s/secrets.yaml.example k8s/secrets.yaml
#   2. Replace placeholder values with real Base64-encoded secrets:
#        echo -n "your_value" | base64
#   3. Apply:  kubectl apply -f k8s/secrets.yaml
#
# IMPORTANT: Never commit k8s/secrets.yaml to version control.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
data:
  # echo -n "mlops" | base64
  POSTGRES_USER: bWxvcHM=
  # echo -n "mlops_password" | base64
  POSTGRES_PASSWORD: bWxvcHNfcGFzc3dvcmQ=
  # echo -n "minioadmin" | base64
  MINIO_ROOT_USER: bWluaW9hZG1pbg==
  # echo -n "minioadmin" | base64
  MINIO_ROOT_PASSWORD: bWluaW9hZG1pbg==
  # echo -n "your_kaggle_username" | base64
  KAGGLE_USERNAME: eW91cl9rYWdnbGVfdXNlcm5hbWU=
  # echo -n "your_kaggle_api_key" | base64
  KAGGLE_KEY: eW91cl9rYWdnbGVfYXBpX2tleQ==
  # echo -n "your_email@gmail.com" | base64
  SMTP_EMAIL: eW91cl9lbWFpbEBnbWFpbC5jb20=
  # echo -n "your_app_password" | base64
  SMTP_PASSWORD: eW91cl9hcHBfcGFzc3dvcmQ=
